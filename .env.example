# ═══ semaje configuration ════════════════════════════════════
# Deployment mode is adapter-driven: the same codebase runs
# single-user self-host, small-team self-host, and cloud.

# ── Database (Postgres) ──────────────────────────────────────
DATABASE_URL=postgres://semaje:semaje@localhost:5432/semaje

# ── Auth adapter ─────────────────────────────────────────────
# single-user → no login at all (default; seeds one org/user)
# local-db    → email+password accounts (small team)
AUTH_ADAPTER=single-user
JWT_SECRET=change-me-in-production
# Frontend mirror of the auth mode (hides/shows login screens)
VITE_AUTH_MODE=single-user

# ── Storage adapter (audio blobs) ────────────────────────────
# fs → local disk (default) | s3 → MinIO/S3/GCS
STORAGE_ADAPTER=fs
STORAGE_FS_DIR=./data/blobs
# s3 settings (MinIO example)
#S3_ENDPOINT=http://localhost:9000
#S3_BUCKET=semaje
#S3_ACCESS_KEY=semaje
#S3_SECRET_KEY=semaje-secret

# ── LLM adapter (the 15 language tasks) ──────────────────────
# ollama       → local Ollama HTTP server running open-weight models (default)
# llama-cpp    → local llama.cpp server (GGUF)
# claude-local → local Claude Code CLI (optional)
LLM_ADAPTER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLAMA_CPP_URL=http://localhost:8081
LLAMA_CPP_MODEL=local-model
LLAMA_CPP_MODEL_FILE=model.gguf
LLM_FALLBACKS=llama-cpp,claude-local
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=nomic-embed-text
#CLAUDE_BIN=claude

# ── Component versions (images from ghcr.io/semajehq) ─────────
SEMAJE_STT_VERSION=2.0.0
SEMAJE_TTS_VERSION=1.0.0
SEMAJE_WEB_VERSION=2.0.0

# ── Speech-to-text (semajehq/semaje-stt) ─────────────────────
STT_URL=http://localhost:8011
STT_API_TOKEN=                       # shared secret between api/worker and stt (recommended in production)
STT_ROUTING=auto                     # auto | whisper | omnilingual
STT_WHISPER_BACKEND=faster-whisper   # faster-whisper | whisper.cpp
STT_WHISPER_MODEL=base               # tiny | base | small | medium | large-v3-turbo | large-v3
STT_OMNILINGUAL_ENABLED=true
STT_OMNILINGUAL_MODEL=omniASR_CTC_300M_v2   # omniASR_{CTC,LLM}_{300M,1B,3B,7B}_v2
STT_DEVICE=cpu                       # cpu | cuda
STT_COMPUTE_TYPE=int8                # int8 (CPU) | float16 (GPU)
STT_MAX_CONCURRENCY=1
STT_MAX_UPLOAD_MB=2048
STT_MAX_DURATION_SEC=21600
#STT_WHISPER_STRONG=en,es,fr,...     # override which languages Whisper handles in auto mode
#STT_MODEL_DIR=~/.local/share/semaje/models
WORKER_CONCURRENCY=1
MAX_QUEUED_JOBS=100

# ── Text-to-speech (semajehq/semaje-tts) ─────────────────────
TTS_URL=http://localhost:8012
TTS_API_TOKEN=
TTS_ALLOW_NONCOMMERCIAL=false        # true enables MMS-TTS (~1,100 languages, CC-BY-NC-4.0 weights)
TTS_AUTO_DOWNLOAD=true               # false for air-gapped hosts (pre-load voices with semaje-tts setup.sh)
#TTS_VOICE_DIR=~/.local/share/semaje/voices
#TTS_CUSTOM_VOICE_DIR=~/.local/share/semaje/voices/custom

# ── API ──────────────────────────────────────────────────────
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
UPLOAD_MAX_MB=500
RATE_LIMIT_POINTS=120
WEBHOOK_SECRET=change-me-webhooks
STRICT_LOCAL_MODE=true
RETENTION_INTERVAL_HOURS=24
DATA_ENCRYPTION_KEY=
METRICS_TOKEN=
METRICS_ORG_ID=
OBSERVABILITY_WER_REPORT=data/observability/stt-eval.json
SHARING_ENABLED=true
SHARE_LOCAL_ONLY=false
TRUST_PROXY_HOPS=0

# ── Optional outbound integrations (all default off) ────────
INTEGRATION_FILE_SYNC_DIR=
NEXTCLOUD_WEBDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_URL=
SMTP_FROM=semaje@localhost

# ── Watched-folder capture ──────────────────────────────────
# Team auth requires a transcribe-scoped key from Platform > API keys.
WATCH_DIR=./data/watch
WATCH_API_KEY=
WATCH_WEBHOOK_URL=
WATCH_SCAN_MS=4000
WATCH_SETTLE_MS=5000

# Optional ffmpeg desktop helper (`npm run desktop`)
DESKTOP_API_BASE=http://localhost:3001
DESKTOP_API_KEY=
DESKTOP_AUDIO_INPUT=

# ── Cloud identity (Phase 3 OIDC adapter seam) ───────────────
#AUTH_ADAPTER=oidc
#OIDC_ISSUER=https://issuer.example
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback

# ── Billing / metering (Phase 4 Stripe seam) ─────────────────
BILLING_ADAPTER=disabled
STRIPE_WEBHOOK_SECRET=
PLAN_MINUTES=1000
PLAN_STORAGE_GB=50

# ── Meeting bot (Phase 4 seam) ───────────────────────────────
MEETING_BOT_ENABLED=false
CALENDAR_OAUTH_CLIENT_ID=
CALENDAR_OAUTH_CLIENT_SECRET=

# ── Frontend ─────────────────────────────────────────────────
