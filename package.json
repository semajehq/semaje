{
  "name": "semaje",
  "version": "2.0.0",
  "description": "semaje platform: API, jobs, realtime, transcript library, auth, local LLM tasks, deploy. Speech, web, and extension live in their own repos.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker -c cyan,yellow \"npm:dev:api\" \"npm:worker\"",
    "dev:api": "tsx watch services/api/src/main.ts",
    "start": "tsx services/api/src/main.ts",
    "worker": "tsx services/jobs/src/worker-main.ts",
    "watch": "tsx services/ingest/src/watcher.ts",
    "desktop": "tsx services/desktop/src/capture.ts",
    "retention": "tsx services/admin/src/retention-main.ts",
    "migrate": "node-pg-migrate -m migrations up",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"services/pipeline/tests/*.test.ts\" \"services/llm/tests/*.test.ts\" \"services/storage/tests/*.test.ts\" \"services/auth/tests/*.test.ts\" \"services/admin/tests/*.test.ts\" \"services/observability/tests/*.test.ts\" \"services/evals/tests/*.test.ts\" \"services/transcripts/tests/*.test.ts\" \"services/search/tests/*.test.ts\" \"services/jobs/tests/*.test.ts\" \"services/ingest/tests/*.test.ts\" \"services/desktop/tests/*.test.ts\" \"services/integrations/tests/*.test.ts\" \"services/realtime/tests/*.test.ts\" \"services/api/tests/*.test.ts\" \"services/billing/tests/*.test.ts\" \"services/meeting-bot/tests/*.test.ts\"",
    "test:all": "npm test",
    "eval:llm": "tsx services/llm/evals/eval_tasks.ts",
    "eval:realtime": "tsx services/realtime/evals/eval_stream.ts",
    "eval:smoke": "tsx services/evals/src/run.ts --profile smoke",
    "eval:stt:capture": "tsx services/evals/src/capture-stt.ts",
    "eval:full": "npm run eval:stt:capture && npm run eval:smoke -- --candidate .eval-results/stt-candidate.json && npm run eval:llm && npm run eval:realtime",
    "workspace": "bash scripts/workspace.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.1",
    "rate-limiter-flexible": "^5.0.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
