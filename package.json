{
  "name": "semaje",
  "version": "2.0.0",
  "description": "semaje \u2014 open-source speech platform: STT + TTS in 1,600+ languages, transcript library, dictation everywhere",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n stt,tts,api,web -c magenta,yellow,cyan,green \"npm:dev:stt\" \"npm:dev:tts\" \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:api": "tsx watch services/api/src/main.ts",
    "dev:stt": "bash services/stt/run.sh",
    "dev:tts": "bash services/tts/run.sh",
    "setup": "bash services/stt/setup.sh && bash services/tts/setup.sh",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx services/api/src/main.ts",
    "worker": "tsx services/jobs/src/worker-main.ts",
    "watch": "tsx services/ingest/src/watcher.ts",
    "desktop": "tsx services/desktop/src/capture.ts",
    "retention": "tsx services/admin/src/retention-main.ts",
    "migrate": "node-pg-migrate -m migrations up",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"services/pipeline/tests/*.test.ts\" \"services/llm/tests/*.test.ts\" \"services/storage/tests/*.test.ts\" \"services/auth/tests/*.test.ts\" \"services/admin/tests/*.test.ts\" \"services/observability/tests/*.test.ts\" \"services/evals/tests/*.test.ts\" \"services/transcripts/tests/*.test.ts\" \"services/search/tests/*.test.ts\" \"services/jobs/tests/*.test.ts\" \"services/ingest/tests/*.test.ts\" \"services/desktop/tests/*.test.ts\" \"services/integrations/tests/*.test.ts\" \"services/realtime/tests/*.test.ts\" \"services/api/tests/*.test.ts\" \"services/extension/tests/native-host.test.ts\" \"services/billing/tests/*.test.ts\" \"services/extension/tests/content.test.ts\" \"services/extension/tests/lib.test.ts\" \"services/extension/tests/host.test.ts\" \"services/extension/tests/build.test.ts\" \"services/meeting-bot/tests/*.test.ts\"",
    "test:stt": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-stt/bin/python\" -m pytest services/stt/tests packages/languages/tests -q",
    "test:tts": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-tts/bin/python\" -m pytest services/tts/tests -q",
    "test:all": "npm test && npm run test:stt && npm run test:tts",
    "test:extension:e2e": "node services/extension/tests/e2e/browser.e2e.mjs --browser chrome && node services/extension/tests/e2e/browser.e2e.mjs --browser firefox",
    "eval:stt": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-stt/bin/python\" -m services.stt.evals.eval_transcription",
    "eval:fleurs": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-stt/bin/python\" -u -m services.stt.evals.eval_fleurs",
    "eval:tts": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-stt/bin/python\" -u -m services.tts.evals.eval_roundtrip --langs en,sw,fr,ne",
    "eval:llm": "tsx services/llm/evals/eval_tasks.ts",
    "eval:realtime": "tsx services/realtime/evals/eval_stream.ts",
    "eval:smoke": "tsx services/evals/src/run.ts --profile smoke",
    "eval:stt:capture": "tsx services/evals/src/capture-stt.ts",
    "eval:full": "npm run eval:stt:capture && npm run eval:smoke -- --candidate .eval-results/stt-candidate.json && npm run eval:fleurs && npm run eval:tts && npm run eval:llm && npm run eval:realtime",
    "ext:build": "node services/extension/scripts/build.mjs",
    "languages:build": "\"${SEMAJE_HOME:-$HOME/.local/share/semaje}/venv-stt/bin/python\" -m packages.languages.build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.576.0",
    "multer": "^2.2.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.1",
    "rate-limiter-flexible": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "jsdom": "^24.1.1",
    "nodemon": "^3.1.4",
    "postcss": "^8.5.16",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.4"
  }
}
